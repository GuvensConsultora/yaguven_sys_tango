<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tango_import_wizard_form" model="ir.ui.view">
        <field name="name">yaguven.tango.import.wizard.form</field>
        <field name="model">yaguven.tango.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group invisible="state == 'done'">
                    <field name="company_id"/>
                    <field name="import_type" widget="radio"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <div invisible="state == 'done' or import_type != 'plan'" class="text-muted">
                    Subí el xlsx de sumas y saldos exportado de Tango. Se toman el código,
                    la descripción y el orden; si ya estaba cargado, se actualizan
                    descripción y orden.
                </div>
                <div invisible="state == 'done' or import_type != 'mapping'" class="text-muted">
                    Columnas: «Código Odoo», «Código Tango» y, opcionales, «Diario» (código o nombre; vacío = equivalencia general de la cuenta) y «Criterio».
                </div>
                <field name="state" invisible="1"/>
                <field name="result" invisible="state != 'done'" nolabel="1"/>
                <footer>
                    <button name="action_import" string="Importar" type="object"
                            class="btn-primary" invisible="state == 'done'"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tango_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar plan Tango / equivalencias</field>
        <field name="res_model">yaguven.tango.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
