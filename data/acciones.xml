<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- El catálogo de rubros se carga por compañía: esta acción lo trae a la
         compañía activa y sólo agrega los que falten. -->
    <record id="action_cargar_rubros" model="ir.actions.server">
        <field name="name">Cargar rubros de la RT 59</field>
        <field name="model_id" ref="model_yaguven_rubro"/>
        <field name="state">code</field>
        <field name="code">action = env["yaguven.rubro"].action_cargar_catalogo()</field>
    </record>
</odoo>
